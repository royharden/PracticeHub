{
  "synthetic": true,
  "railId": "RAIL-012",
  "class": "BOUNDARY",
  "description": "imaging-sim: the exact edge — the destination completes part of the order — the open milestone survives the partial completion.",
  "cases": [
    {
      "op": "arm",
      "name": "arm X-11 for exactly one request",
      "primitiveId": "X-11",
      "options": {
        "count": 1
      }
    },
    {
      "op": "dispatch",
      "name": "the armed X-11 shapes the first request",
      "request": {
        "operation": "place-order",
        "idempotencyKey": "synthetic-rail-012-boundary",
        "payloadRef": "synthetic-payload-rail-012-boundary",
        "requestedAt": "2026-01-01T00:00:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "accepted",
        "effectState": "partial",
        "receiptRef": "present",
        "requiresReconciliation": true
      }
    },
    {
      "op": "drain-receipts",
      "name": "the receipts the rail actually emitted, in drain order",
      "expect": {
        "kinds": ["partial"]
      }
    },
    {
      "op": "dispatch",
      "name": "the very next attempt on the same key adds no second external effect",
      "request": {
        "operation": "place-order",
        "idempotencyKey": "synthetic-rail-012-boundary",
        "payloadRef": "synthetic-payload-rail-012-boundary",
        "requestedAt": "2026-01-01T00:01:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "attempts": 2,
        "resendsExternalEffect": false
      }
    },
    {
      "op": "snapshot",
      "name": "still exactly one ledger record for the key",
      "expect": {
        "effects": 1
      }
    }
  ]
}
