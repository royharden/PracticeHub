{
  "synthetic": true,
  "railId": "RAIL-017",
  "class": "BOUNDARY",
  "description": "payerportal-sim: the exact edge — the payer answers out of order — arrival order is not freshness, and each response stays versioned evidence.",
  "cases": [
    {
      "op": "arm",
      "name": "arm X-07 for exactly one request",
      "primitiveId": "X-07",
      "options": {
        "count": 1
      }
    },
    {
      "op": "dispatch",
      "name": "the armed X-07 shapes the first request",
      "request": {
        "operation": "check-eligibility",
        "idempotencyKey": "synthetic-rail-017-boundary",
        "payloadRef": "synthetic-payload-rail-017-boundary",
        "requestedAt": "2026-01-01T00:00:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "accepted",
        "effectState": "landed",
        "receiptRef": "present",
        "requiresReconciliation": false
      }
    },
    {
      "op": "drain-receipts",
      "name": "the receipts the rail actually emitted, in drain order",
      "expect": {
        "kinds": ["late", "primary"],
        "sequences": [2, 1]
      }
    },
    {
      "op": "dispatch",
      "name": "the very next attempt on the same key adds no second external effect",
      "request": {
        "operation": "check-eligibility",
        "idempotencyKey": "synthetic-rail-017-boundary",
        "payloadRef": "synthetic-payload-rail-017-boundary",
        "requestedAt": "2026-01-01T00:01:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "attempts": 2,
        "resendsExternalEffect": false
      }
    },
    {
      "op": "snapshot",
      "name": "still exactly one ledger record for the key",
      "expect": {
        "effects": 1
      }
    }
  ]
}
