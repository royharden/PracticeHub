{
  "synthetic": true,
  "railId": "RAIL-022",
  "class": "BOUNDARY",
  "description": "model-sim: the exact edge — the answer arrives from an unpinned model version: it lands, and the divergence surfaces for reconciliation instead of passing silently.",
  "cases": [
    {
      "op": "arm",
      "name": "arm X-18 for exactly one request",
      "primitiveId": "X-18",
      "options": {
        "count": 1
      }
    },
    {
      "op": "dispatch",
      "name": "the armed X-18 shapes the first request",
      "request": {
        "operation": "complete",
        "idempotencyKey": "synthetic-rail-022-boundary",
        "payloadRef": "synthetic-payload-rail-022-boundary",
        "requestedAt": "2026-01-01T00:00:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "accepted",
        "effectState": "landed",
        "vendorVersionDrifted": true,
        "requiresReconciliation": true
