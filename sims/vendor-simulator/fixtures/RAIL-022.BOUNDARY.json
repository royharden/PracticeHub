        "operation": "complete",
        "idempotencyKey": "synthetic-rail-022-boundary",
        "payloadRef": "synthetic-payload-rail-022-boundary",
        "requestedAt": "2026-01-01T00:01:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "deduplicated",
        "attempts": 2
      }
    },
    {
      "op": "snapshot",
      "name": "still exactly one ledger record for the key",
      "expect": {
        "effects": 1
      }
    }
  ]
