{
  "synthetic": true,
  "railId": "RAIL-015",
  "class": "BOUNDARY",
  "description": "erx-network-sim: the exact edge — the real network outcome lands after the fence — it reopens correction/reversal rather than re-transmitting.",
  "cases": [
    {
      "op": "arm",
      "name": "arm X-08 for exactly one request",
      "primitiveId": "X-08",
      "options": {
        "count": 1
      }
    },
    {
      "op": "dispatch",
      "name": "the armed X-08 shapes the first request",
      "request": {
        "operation": "transmit-script",
        "idempotencyKey": "synthetic-rail-015-boundary",
        "payloadRef": "synthetic-payload-rail-015-boundary",
        "requestedAt": "2026-01-01T00:00:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "accepted",
        "effectState": "landed",
        "receiptRef": "present",
        "requiresReconciliation": true
      }
    },
    {
      "op": "drain-receipts",
      "name": "the receipts the rail actually emitted, in drain order",
      "expect": {
        "kinds": ["late"]
      }
    },
    {
      "op": "dispatch",
      "name": "the very next attempt on the same key adds no second external effect",
      "request": {
        "operation": "transmit-script",
        "idempotencyKey": "synthetic-rail-015-boundary",
        "payloadRef": "synthetic-payload-rail-015-boundary",
        "requestedAt": "2026-01-01T00:01:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "attempts": 2,
        "resendsExternalEffect": false
      }
    },
    {
      "op": "snapshot",
      "name": "still exactly one ledger record for the key",
      "expect": {
        "effects": 1
      }
    }
  ]
}
