{
  "synthetic": true,
  "railId": "RAIL-002",
  "class": "BOUNDARY",
  "description": "athena-sim: the exact edge — a stale-version write conflicts; the retry, holding the current version, lands.",
  "cases": [
    {
      "op": "arm",
      "name": "arm X-15 for exactly one request",
      "primitiveId": "X-15",
      "options": {
        "count": 1
      }
    },
    {
      "op": "dispatch",
      "name": "the armed X-15 shapes the first request",
      "request": {
        "operation": "write-appointment",
        "idempotencyKey": "synthetic-rail-002-boundary",
        "payloadRef": "synthetic-payload-rail-002-boundary",
        "requestedAt": "2026-01-01T00:00:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "conflict",
        "effectState": "not-landed",
        "attempts": 1
      }
    },
    {
      "op": "drain-receipts",
      "name": "a request that never landed issues no receipt",
      "expect": {
        "kinds": []
      }
    },
    {
      "op": "dispatch",
      "name": "the scenario is exhausted, so the retry of the not-landed effect lands",
      "request": {
        "operation": "write-appointment",
        "idempotencyKey": "synthetic-rail-002-boundary",
        "payloadRef": "synthetic-payload-rail-002-boundary",
        "requestedAt": "2026-01-01T00:01:00Z",
        "payload": {
          "synthetic": true,
          "ref": "synthetic-body-boundary"
        }
      },
      "expect": {
        "status": "accepted",
        "effectState": "landed",
        "attempts": 2
      }
    },
    {
      "op": "snapshot",
      "name": "still exactly one ledger record for the key",
      "expect": {
        "effects": 1
      }
    }
  ]
}
